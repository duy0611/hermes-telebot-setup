# Model credentials for the isolated gateway (hermes-telebot).
# Read by hermes-telebot-provision.sh. Keep this file at mode 0600.
# Leave a value empty to skip it.
#
# The script maps these to config.yaml:
#   providers.litellm.base_url <- LITELLM_BASE_URL
#   providers.litellm.key_env  <- LITELLM_API_KEY  (the key itself stays in .env)
#   model.provider             <- "litellm"
#   model.default              <- LITELLM_MODEL
#
# If your LiteLLM is on this host, the base URL is usually the /v1 form, e.g.
#   LITELLM_BASE_URL=http://127.0.0.1:4000/v1

LITELLM_BASE_URL=https://llm.llmxyz.net/v1
LITELLM_API_KEY=sk-xxxx
LITELLM_MODEL=cloud.deepseek-v4.1-flash
